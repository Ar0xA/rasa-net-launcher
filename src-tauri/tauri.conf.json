{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infinite Rasa Launcher",
  "version": "1.0.0",
  "identifier": "org.infiniterasa.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Infinite Rasa",
        "width": 560,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Infinite Rasa",
    "copyright": "Infinite Rasa project",
    "category": "Game",
    "shortDescription": "Infinite Rasa Launcher",
    "longDescription": "Verifies your Tabula Rasa 1.16.5.0 install and launches the game on Infinite Rasa.",
    "homepage": "https://infiniterasa.org",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Infinite Rasa"
      }
    }
  }
}
